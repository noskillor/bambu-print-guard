# /etc/print-guard-ctl.conf  (chmod 600)
VMID=105
HA_URL=http://homeassistant.local:8123
STATUS_SENSOR=sensor.p1s_print_status
# File containing a Home Assistant long-lived access token (chmod 600)
TOKEN_FILE=/root/.print-guard-ha-token
# Printer states that keep the container running
ACTIVE_STATES="running pause prepare slicing init"
# Number of 30-second checks without a print before the container is stopped
IDLE_LIMIT=4
