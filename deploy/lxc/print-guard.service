[Unit]
Description=bambu-print-guard (AI print failure detection)
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
ExecStart=/usr/bin/python3 -u /opt/print-guard/print_guard.py --config /opt/print-guard/config.json
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
